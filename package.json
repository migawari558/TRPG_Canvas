{
  "name": "trpg-canvas",
  "version": "0.12.10",
  "private": true,
  "description": "TRPGシナリオのためのローカル執筆アプリ",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron tests/smoke.cjs",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "test:hierarchy": "electron tests/hierarchy-smoke.cjs",
    "test:dashboard": "electron tests/dashboard-smoke.cjs",
    "test:appearance": "electron tests/appearance-smoke.cjs",
    "dist": "npm run build && electron-builder --win portable",
    "test:flow-first": "electron tests/flow-first-smoke.cjs",
    "test:delete": "electron tests/delete-smoke.cjs",
    "test:pdf-columns": "electron tests/pdf-columns.cjs",
    "test:typography": "electron tests/typography-smoke.cjs",
    "test:images": "electron tests/images-smoke.cjs",
    "test:tasks": "electron tests/tasks-smoke.cjs",
    "test:search": "electron tests/search-smoke.cjs",
    "test:chapters": "electron tests/chapters-smoke.cjs",
    "build:icon": "electron scripts/build-icon.cjs",
    "test:workflow": "electron tests/workflow-smoke.cjs",
    "test:startup": "electron tests/startup-recovery.cjs",
    "test:pdf-pagination": "electron tests/pdf-pagination.cjs",
    "test:writer": "electron tests/writer-smoke.cjs",
    "test:pdf-writer": "electron tests/pdf-writer.cjs",
    "test:pdf-page-sizes": "electron tests/pdf-page-sizes.cjs",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:mac": "npm run build && node scripts/build-mac.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-heading": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@xyflow/react": "^12.4.4",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "jp.trpgcanvas.app",
    "productName": "TRPG Canvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/icon.icns"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "TRPG-Canvas-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "TRPG-Canvas-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "TRPG Canvas ${version}",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
