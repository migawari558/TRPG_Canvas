{
  "name": "trpg-canvas",
  "version": "0.3.0",
  "private": true,
  "description": "TRPGシナリオのためのローカル執筆アプリ",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron tests/smoke.cjs",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "test:hierarchy": "electron tests/hierarchy-smoke.cjs",
    "test:dashboard": "electron tests/dashboard-smoke.cjs",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@xyflow/react": "^12.4.4",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "jp.trpgcanvas.app",
    "productName": "TRPG Canvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
