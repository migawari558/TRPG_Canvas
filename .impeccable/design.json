  "components": [
    {
      "name": "Selected mode",
      "kind": "button",
      "refersTo": "mode-selected",
      "description": "Solid ink marks the current body or flow mode.",
      "html": "<button class=\"ds-mode\" aria-pressed=\"true\">本文</button>",
      "css": ".ds-mode{font-family:'Yu Gothic UI','Meiryo',sans-serif;font-size:12px;transition:background-color 150ms ease-out,color 150ms ease-out,border-color 150ms ease-out;background:#2d664e;color:#ffffff;border:0;border-radius:5px;min-height:28px;padding:4px 12px}.ds-mode:hover{background:#dae8dc;color:#243c33}.ds-mode:focus-visible{outline:2px solid #2d664e;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-mode{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Paper action for flow tools.",
      "html": "<button class=\"ds-action\">左→右に整列</button>",
      "css": ".ds-action{font-family:'Yu Gothic UI','Meiryo',sans-serif;font-size:12px;transition:background-color 150ms ease-out,color 150ms ease-out,border-color 150ms ease-out;min-height:32px;padding:6px 10px;border:1px solid #cbd7cd;border-radius:6px;background:#fcfdfb;color:#243c33}.ds-action:hover{background:#dae8dc}.ds-action:focus-visible{outline:2px solid #2d664e;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}"
    },
    {
      "name": "Outline search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Compact search field for structural navigation.",
      "html": "<label class=\"ds-search\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"目次を検索\" placeholder=\"見出しを検索\" type=\"search\"/></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;min-height:36px;padding:0 10px;border:1px solid #cbd7cd;border-radius:6px;background:#fcfdfb;color:#526b5d}.ds-search input{font-family:'Yu Gothic UI','Meiryo',sans-serif;font-size:12px;border:0;background:transparent;color:#243c33;padding:8px 0;outline:none}.ds-search input::placeholder{color:#526b5d;opacity:1}.ds-search:hover{border-color:#2d664e}.ds-search:focus-within{outline:2px solid #2d664e;outline-offset:2px}"
    },
    {
      "name": "Outline count",
      "kind": "chip",
      "description": "Quiet count metadata in the outline title.",
      "html": "<span class=\"ds-count\">12</span>",
      "css": ".ds-count{font-family:'Yu Gothic UI','Meiryo',sans-serif;font-size:11px;font-weight:500;padding:2px 7px;border-radius:4px;background:#dae8dc;color:#2d664e}"
    },
    {
      "name": "Rail navigation",
      "kind": "nav",
      "description": "Dark binding with a contained current destination.",
      "html": "<nav class=\"ds-rail\" aria-label=\"アプリメニュー\"><button class=\"ds-rail-button\" aria-label=\"マイシナリオ\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 7h6l2 2h10v11H3z\"/></svg></button></nav>",
      "css": ".ds-rail{display:flex;width:60px;justify-content:center;background:#244b3c;padding:16px 0}.ds-rail-button{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:8px;background:#3c6651;color:#f2f8f2;transition:background-color 150ms ease-out}.ds-rail-button:hover{background:#3c6651;color:#f2f8f2}.ds-rail-button:focus-visible{outline:2px solid #f2f8f2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-rail-button{transition:none}}"
    },
    {
      "name": "Scene card",
      "kind": "card",
      "refersTo": "scene-card",
      "description": "Flat flow card; selection adds a visible outline.",
      "html": "<article class=\"ds-scene\"><strong>導入のシーン</strong><p>本文あり</p><button>本文を開く</button></article>",
      "css": ".ds-scene{font-family:'Yu Gothic UI','Meiryo',sans-serif;padding:16px;border:1px solid #cbd7cd;border-radius:10px;background:#fcfdfb;color:#243c33;max-width:260px}.ds-scene strong{font-size:15px;font-weight:600;line-height:1.6}.ds-scene p{font-size:12px;color:#2d664e}.ds-scene button{font-family:'Yu Gothic UI','Meiryo',sans-serif;font-size:12px;transition:background-color 150ms ease-out,color 150ms ease-out,border-color 150ms ease-out;padding:7px 10px;border:0;border-radius:5px;background:#dae8dc;color:#2d664e;width:100%}.ds-scene button:hover{background:#dae8dc}.ds-scene button:focus-visible{outline:2px solid #2d664e;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-scene button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Bound Manuscript and Structural Index",
    "overview": "The desktop workspace pairs a readable manuscript with a persistent structural index. A deep navigation rail anchors tinted working panels and a quiet paper surface. Japanese system UI lettering keeps operational controls familiar; manuscript fonts remain an author preference.\n\nThis system describes the desktop implementation in `src/desktop.css` and `src/desktop-themes.mjs`, together with its inherited document typography. Android retains its separate interface and styles. The six color families share component geometry and semantic roles, with custom themes supplying their own computed colors.",
    "keyCharacteristics": [
      "Dark binding, tinted structure, legible manuscript.",
      "Compact operational controls with visible focus and selection.",
      "Independent outline, formatting and writing notes.",
      "Flat document and library surfaces; restrained floating tools."
    ],
    "rules": [
      {
        "name": "The Bound Surface Rule",
        "body": "Keep navigation, structural panels and manuscript paper as distinct semantic color roles in every theme.",
        "section": "colors"
      },
      {
        "name": "The Contained Selection Rule",
        "body": "Active outline rows use a full soft tint; the selected body or flow mode uses solid accent and its paired foreground.",
        "section": "colors"
      },
      {
        "name": "The Working Depth Rule",
        "body": "Reserve workspace elevation for floating tools and responsive overlays; regular manuscript and library surfaces remain flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep manuscript colors, structural panels and navigation roles distinct across all six palettes and custom themes.",
      "Do preserve author-selected manuscript fonts while using familiar Japanese system lettering for operational controls.",
      "Do retain visible keyboard focus, ancestry in outline search and differentiated scene, information and group geometry.",
      "Do keep outline, formatting and writing notes independently accessible."
    ],
    "donts": [
      "Don't hide the application rail when closing the outline.",
      "Don't turn active outline selection into a decorative side stripe.",
      "Don't apply this desktop system to Android's separate interface.",
      "Don't replace readable theme roles with incidental decorative colors."
    ]
  }
}
